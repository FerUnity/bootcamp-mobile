CREATE TABLE holidays (
   date TEXT NOT NULL PRIMARY KEY,   -- "2025-01-01"
      localName TEXT NOT NULL,
      name TEXT NOT NULL
);

selectAllUsers:
SELECT * FROM holidays WHERE date = ?;

selectByYear:
SELECT * FROM holidays WHERE date LIKE ?;

insertOrReplace:
INSERT OR REPLACE INTO holidays (date, localName, name)
VALUES (?, ?, ?);
